# Mindful Money — env configuration
# В MVP приложение работает без бэкенда (localStorage-only),
# поэтому обязательных переменных нет. Railway автоматически
# проставит NODE_ENV=production и PORT.

# === Обязательные (если появится backend в v1.1+) ===
# DATABASE_URL=postgres://user:pass@host:5432/mindful
# REDIS_URL=redis://host:6379

# === AI (Шаг 9, пока rule-based на клиенте) ===
# Если будете подключать LLM-генерацию copy на серверной стороне:
# ANTHROPIC_API_KEY=sk-ant-...
# или OPENAI_API_KEY=sk-...

# === Auth (TZ 10.1, v1 не в MVP) ===
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# или Supabase:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# === Observability (TZ 10.6) ===
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# === FX provider (TZ 7.7 MC-03, v1) ===
# CBR_API_URL=https://www.cbr-xml-daily.ru/daily_json.js

# === Transactional email (TZ 10.1, weekly digest AI-01) ===
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# === Runtime (Railway проставит сам, локально можно) ===
# PORT=3000
# NODE_ENV=production
